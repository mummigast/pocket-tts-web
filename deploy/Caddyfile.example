# Example Caddy site for putting the UI on the internet. Adapt to your own setup.
# The app has NO login of its own: everything except /s/* (share links) MUST be behind a login.
# Make a password hash with:  caddy hash-password
tts.example.com {
	encode zstd gzip
	request_body {
		max_size 50MB
	}
	# Share links: no login, the app checks the link's token itself.
	handle /s/* {
		reverse_proxy 127.0.0.1:18700
	}
	# Everything else: your login (basic auth here; forward_auth to Authentik/oauth2-proxy also works).
	handle {
		basic_auth {
			you $2a$14$REPLACE_WITH_OUTPUT_OF_caddy_hash-password
		}
		reverse_proxy 127.0.0.1:18700
	}
}
